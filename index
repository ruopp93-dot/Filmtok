<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FilmTok - Ваши рекомендации</title>
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        ::-webkit-scrollbar { width: 0px; background: transparent; }
        html, body { height: 100vh; font-family: 'Inter', sans-serif; }
        .text-shadow { text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8); }
        .snap-container { scroll-behavior: smooth; }
        .gradient-overlay { background: linear-gradient(to top, rgba(0,0,0,0.85) 20%, rgba(0,0,0,0) 60%); }
        .movie-slide-bg { background-size: cover; background-position: center center; }
        .btn-like.liked { color: #ef4444; fill: #ef4444; }
        .similar-poster {
            width: 100px;
            height: 150px;
            background-size: cover;
            background-position: center;
            border-radius: 0.5rem;
            flex-shrink: 0;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        .comment {
            background-color: rgba(255, 255, 255, 0.03);
            border-radius: 0.5rem;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
        }
        body.bg-black { background-color: #000; color: #fff; overflow: hidden; }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-black text-white">

    <!-- Loading screen -->
    <div id="loading-screen" class="fixed inset-0 bg-black flex items-center justify-center z-50">
        <div class="text-center">
            <svg class="animate-spin h-10 w-10 text-white mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p id="loading-text" class="mt-2 text-lg font-semibold">Аутентификация...</p>
        </div>
    </div>

    <!-- App -->
    <div id="app-screen" class="h-screen w-screen hidden">
        <button id="profile-btn" class="fixed top-6 left-6 z-30 text-white bg-black bg-opacity-30 p-2 rounded-full hover:bg-opacity-50 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
        </button>
        <div id="feed-status" class="fixed top-6 right-6 z-30 text-white bg-black bg-opacity-30 px-3 py-1 rounded-full text-sm font-semibold">
            ...
        </div>
        <main id="feed" class="snap-container h-screen w-screen overflow-y-scroll snap-y snap-mandatory">
            <!-- slides go here -->
        </main>
    </div>

    <!-- Details modal -->
    <div id="details-modal" class="fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-40 hidden p-4">
        <div id="modal-content" class="bg-gray-900 rounded-2xl max-w-lg w-full max-h-[95vh] overflow-y-auto p-6 relative shadow-xl">
            <button id="close-modal" class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors z-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <div class="flex flex-col md:flex-row gap-6 mb-6">
                <img id="modal-poster" src="https://placehold.co/500x750/333/ccc?text=Poster" alt="Постер" class="w-1/2 md:w-1/3 rounded-lg shadow-lg self-start">
                <div class="flex-1">
                    <h2 id="modal-title" class="text-3xl font-bold mb-2">Название фильма</h2>
                    <div class="flex items-center gap-4 text-gray-400 mb-4">
                        <span id="modal-rating" class="flex items-center gap-1">...</span>
                        <span id="modal-year" class="text-lg">...</span>
                    </div>
                    <p id="modal-overview" class="text-gray-200 mb-4">Описание...</p>
                    <div id="modal-genres" class="flex flex-wrap gap-2 mb-6">...</div>
                    <a id="modal-trailer-link" href="#" target="_blank" rel="noopener noreferrer" class="hidden ...">Смотреть трейлер</a>
                </div>
            </div>
            <div class="mb-6">
                <h3 class="text-2xl font-semibold mb-4">Похожие фильмы</h3>
                <div id="similar-movies-grid" class="flex overflow-x-auto gap-4 pb-4">
                    <p id="no-similar-message" class="text-gray-400">Похожих фильмов не найдено.</p>
                </div>
            </div>
            <div>
                <h3 class="text-2xl font-semibold mb-4">Комментарии</h3>
                <form id="comment-form" class="mb-4">
                    <textarea id="comment-input" class="w-full p-3 bg-gray-800 rounded border border-gray-700 text-white" rows="3" placeholder="Оставить комментарий..." required></textarea>
                    <button type="submit" class="mt-2 bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded transition-colors">Отправить</button>
                </form>
                <div id="comments-list" class="max-h-60 overflow-y-auto">
                    <p id="no-comments-message" class="text-gray-400">Комментариев пока нет.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile modal -->
    <div id="profile-modal" class="fixed inset-0 bg-gray-900 z-40 hidden p-4 pt-16 overflow-y-auto">
        <button id="close-profile-modal" class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors z-10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        <div class="max-w-4xl mx-auto text-white">
            <h2 class="text-3xl font-bold mb-2">Личный кабинет</h2>
            <p class="text-sm text-gray-400 mb-1">Ваш анонимный ID:</p>
            <input id="user-id-display" readonly class="text-xs text-gray-300 bg-gray-800 w-full p-2 rounded mb-6" value="Загрузка..."/>
            <h3 class="text-2xl font-semibold mb-4">Ваши лайки</h3>
            <div id="liked-movies-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                <p id="no-likes-message" class="col-span-full text-gray-400">У вас пока нет лайков.</p>
            </div>
        </div>
    </div>

    <!-- Firebase & App logic -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, setLogLevel, doc, getDoc, setDoc, addDoc, collection, getDocs, runTransaction, query, where, Timestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // --- TMDB ---
        const API_KEY = '64caf85ec2b1fe28c66065dd95b5720c'; // оставил твой ключ (если нужно, замените)
        const BASE_URL = 'https://api.themoviedb.org/3';
        const IMG_URL_BACKDROP = 'https://image.tmdb.org/t/p/original';
        const IMG_URL_POSTER = 'https://image.tmdb.org/t/p/w500';
        const YOUTUBE_WATCH_URL = 'https://www.youtube.com/watch?v=';
        const PLACEHOLDER_POSTER = 'https://placehold.co/500x750/333/ccc?text=Poster';
        const PLACEHOLDER_BACKDROP = 'https://placehold.co/1920x1080/000/ccc?text=FilmTok';

        // Firebase vars
        let app, auth, db;
        let userId = null;
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'filmtok-default-app';

        // DOM
        const loadingScreen = document.getElementById('loading-screen');
        const loadingText = document.getElementById('loading-text');
        const appScreen = document.getElementById('app-screen');
        const feedContainer = document.getElementById('feed');
        const feedStatus = document.getElementById('feed-status');
        const modal = document.getElementById('details-modal');
        const closeModalBtn = document.getElementById('close-modal');
        const similarMoviesGrid = document.getElementById('similar-movies-grid');
        const noSimilarMessage = document.getElementById('no-similar-message');
        const commentsList = document.getElementById('comments-list');
        const noCommentsMessage = document.getElementById('no-comments-message');
        const commentForm = document.getElementById('comment-form');
        const commentInput = document.getElementById('comment-input');
        const profileModal = document.getElementById('profile-modal');
        const profileBtn = document.getElementById('profile-btn');
        const closeProfileBtn = document.getElementById('close-profile-modal');
        const userIdDisplay = document.getElementById('user-id-display');
        const likedMoviesGrid = document.getElementById('liked-movies-grid');
        const noLikesMessage = document.getElementById('no-likes-message');

        // state
        let moviesData = [];
        let userLikes = new Set();
        let userProfile = {};
        let currentPage = 1;
        let isLoading = false;
        let currentFeedUrl = '';
        let isRecommendedFeed = false;
        let currentMovieIdForModal = null;

        document.addEventListener('DOMContentLoaded', init);

        function init() {
            initFirebase();
        }

        function initFirebase() {
            try {
                const firebaseConfig = (typeof __firebase_config !== 'undefined' && __firebase_config) ? JSON.parse(__firebase_config) : null;
                if (!firebaseConfig) throw new Error('Firebase config not provided. Define __firebase_config.');
                app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);
                setLogLevel('Debug');
                initAuth();
            } catch (error) {
                console.warn('Firebase is not initialized:', error.message);
                // Если Firebase нет — переключаемся в offline-режим (функционал ограничен)
                loadingText.textContent = 'Firebase не настроен — работает только лента TMDB.';
                feedStatus.textContent = 'Лента: Популярное';
                feedStatus.classList.remove('hidden');
                currentFeedUrl = `${BASE_URL}/movie/popular?api_key=${API_KEY}&language=ru-RU`;
                fetchMovies(true).then(() => {
                    appScreen.classList.remove('hidden');
                    loadingScreen.classList.add('hidden');
                });
            }
        }

        // auth
        function initAuth() {
            onAuthStateChanged(auth, async (user) => {
                if (user) {
                    userId = user.uid;
                    userIdDisplay.value = userId;
                    loadingText.textContent = 'Загружаем ваш профиль...';
                    await loadUserProfile();
                    appScreen.classList.remove('hidden');
                    loadingScreen.classList.add('hidden');
                }
            });

            (async () => {
                try {
                    const token = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                    if (token) await signInWithCustomToken(auth, token);
                    else if (!auth.currentUser) await signInAnonymously(auth);
                } catch (error) {
                    console.error('Ошибка аутентификации:', error);
                    loadingText.textContent = 'Ошибка входа. Попробуйте обновить страницу.';
                }
            })();
        }

        // load profile & likes
        async function loadUserProfile() {
            if (!userId) return;
            loadingText.textContent = 'Загружаем ваши лайки...';
            userLikes.clear();
            try {
                const likesCol = collection(db, `artifacts/${appId}/users/${userId}/likes`);
                const likesSnap = await getDocs(likesCol);
                likesSnap.docs.forEach(d => userLikes.add(d.id));

                const profileRef = doc(db, `artifacts/${appId}/users/${userId}/data/profile`);
                const profileSnap = await getDoc(profileRef);

                let feedUrl = `${BASE_URL}/movie/popular?api_key=${API_KEY}&language=ru-RU`;
                isRecommendedFeed = false;

                if (profileSnap.exists() && (profileSnap.data().totalLikes || 0) > 5) {
                    userProfile = profileSnap.data();
                    feedUrl = buildRecommendationUrl(userProfile);
                    isRecommendedFeed = true;
                }

                feedStatus.textContent = isRecommendedFeed ? 'Лента: Рекомендации' : 'Лента: Популярное';
                feedStatus.classList.remove('hidden');
                currentFeedUrl = feedUrl;
                await fetchMovies(true);
            } catch (error) {
                console.error('Ошибка загрузки профиля:', error);
                loadingText.textContent = 'Ошибка загрузки профиля.';
            }
        }

        function buildRecommendationUrl(profile) {
            const params = new URLSearchParams({ api_key: API_KEY, language: 'ru-RU', sort_by: 'popularity.desc' });
            if (profile.genres) {
                const topGenres = Object.entries(profile.genres).sort((a,b)=>b[1]-a[1]).slice(0,2).map(g=>g[0]);
                if (topGenres.length) params.append('with_genres', topGenres.join(','));
            }
            if (profile.avgRating && profile.avgRating > 0) params.append('vote_average.gte', Math.max(0, Math.floor(profile.avgRating)-1));
            return `${BASE_URL}/discover/movie?${params.toString()}`;
        }

        async function fetchMovies(isNewFeed = false) {
            if (isLoading) return;
            isLoading = true;
            if (isNewFeed) {
                currentPage = 1;
                moviesData = [];
                feedContainer.innerHTML = '';
            }
            try {
                if (!currentFeedUrl) currentFeedUrl = `${BASE_URL}/movie/popular?api_key=${API_KEY}&language=ru-RU`;
                const url = `${currentFeedUrl}&page=${currentPage}`;
                const res = await fetch(url);
                const data = await res.json();
                if (data && data.results && data.results.length) {
                    const newMovies = data.results;
                    moviesData.push(...newMovies);
                    renderMovies(newMovies, isRecommendedFeed);
                    currentPage++;
                }
            } catch (error) {
                console.error('Ошибка загрузки фильмов:', error);
            } finally {
                isLoading = false;
            }
        }

        function renderMovies(movies, isRecommended) {
            movies.forEach(movie => {
                const slide = createMovieSlide(movie, isRecommended);
                feedContainer.appendChild(slide);
            });
        }

        function createMovieSlide(movie, isRecommended) {
            const bgUrl = movie.backdrop_path ? `${IMG_URL_BACKDROP}${movie.backdrop_path}` : (movie.poster_path ? `${IMG_URL_BACKDROP}${movie.poster_path}` : PLACEHOLDER_BACKDROP);
            const slide = document.createElement('div');
            slide.className = 'movie-slide relative h-screen w-screen snap-start flex items-center justify-center bg-black movie-slide-bg';
            slide.dataset.movieId = String(movie.id);
            slide.style.backgroundImage = `url('${bgUrl}')`;
            const isLiked = userLikes.has(String(movie.id));
            slide.innerHTML = `
                ${isRecommended ? '<span class="absolute top-20 left-6 z-20 bg-blue-500 text-white px-3 py-1 rounded-full text-xs font-bold">Для вас</span>' : ''}
                <div class="absolute inset-0 z-10 p-6 flex flex-col justify-end gradient-overlay">
                    <div class="flex justify-between items-end gap-4">
                        <div class="w-3/4 text-shadow">
                            <h2 class="text-3xl font-bold mb-2">${escapeHtml(movie.title || '')}</h2>
                            <p class="text-sm text-gray-200 line-clamp-3">${escapeHtml(movie.overview || 'Описание отсутствует.')}</p>
                        </div>
                        <div class="flex flex-col space-y-5 items-center">
                            <button class="action-btn btn-like ${isLiked ? 'liked' : ''}" title="В избранное">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.5l1.318-1.182a4.5 4.5 0 116.364 6.364L12 20.25l-7.682-7.682a4.5 4.5 0 010-6.364z" /></svg>
                                <span class="text-xs">${movie.vote_count || 0}</span>
                            </button>
                            <button class="action-btn btn-details" title="Подробнее">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
                            </button>
                        </div>
                    </div>
                </div>`;
            return slide;
        }

        // helper to avoid XSS when injecting text
        function escapeHtml(str) {
            return String(str)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        async function handleLike(movie, likeBtn) {
            if (!userId || !db) {
                // If no Firebase — simple local toggle
                const id = String(movie.id);
                if (userLikes.has(id)) {
                    userLikes.delete(id);
                    likeBtn.classList.remove('liked');
                } else {
                    userLikes.add(id);
                    likeBtn.classList.add('liked');
                }
                return;
            }

            likeBtn.classList.add('liked');
            userLikes.add(String(movie.id));
            const movieRef = doc(db, `artifacts/${appId}/users/${userId}/likes/${movie.id}`);
            const profileRef = doc(db, `artifacts/${appId}/users/${userId}/data/profile`);

            try {
                await runTransaction(db, async (transaction) => {
                    const profileSnap = await transaction.get(profileRef);
                    let profile = profileSnap.exists() ? profileSnap.data() : { genres: {}, totalLikes: 0, ratingSum: 0, avgRating: 0 };
                    transaction.set(movieRef, movie);
                    profile.totalLikes = (profile.totalLikes || 0) + 1;
                    profile.ratingSum = (profile.ratingSum || 0) + (movie.vote_average || 0);
                    profile.avgRating = profile.ratingSum / profile.totalLikes;
                    (movie.genre_ids || []).forEach(gid => { profile.genres[gid] = (profile.genres[gid] || 0) + 1; });
                    transaction.set(profileRef, profile);
                });
            } catch (error) {
                console.error('Ошибка при добавлении лайка:', error);
                likeBtn.classList.remove('liked');
                userLikes.delete(String(movie.id));
            }
        }

        // infinite scroll
        feedContainer.addEventListener('scroll', () => {
            const lastSlide = feedContainer.querySelector('.movie-slide:last-child');
            if (lastSlide && lastSlide.getBoundingClientRect().top < window.innerHeight * 1.5 && !isLoading) {
                fetchMovies(false);
            }
        });

        // click handlers
        feedContainer.addEventListener('click', (e) => {
            const likeBtn = e.target.closest('.btn-like');
            const detailsBtn = e.target.closest('.btn-details');
            const slide = e.target.closest('.movie-slide');
            if (!slide) return;
            const movieId = slide.dataset.movieId;
            const movie = moviesData.find(m => String(m.id) === String(movieId));
            if (!movie) return;
            if (likeBtn && !likeBtn.classList.contains('liked')) handleLike(movie, likeBtn);
            if (detailsBtn) showDetails(movie);
        });

        // details modal
        async function showDetails(movie) {
            currentMovieIdForModal = movie.id;
            let details = movie;
            try {
                const res = await fetch(`${BASE_URL}/movie/${movie.id}?api_key=${API_KEY}&language=ru-RU&append_to_response=videos,genres`);
                details = await res.json();
            } catch (e) { console.warn('Не удалось загрузить детали, используем базовые данные.'); }

            const posterUrl = details.poster_path ? `${IMG_URL_POSTER}${details.poster_path}` : PLACEHOLDER_POSTER;
            document.getElementById('modal-poster').src = posterUrl;
            document.getElementById('modal-title').textContent = details.title || movie.title || '—';
            document.getElementById('modal-rating').innerHTML = `★ ${(details.vote_average || 0).toFixed(1)}`;
            document.getElementById('modal-year').textContent = details.release_date ? details.release_date.split('-')[0] : 'N/A';
            document.getElementById('modal-overview').textContent = details.overview || movie.overview || 'Описание отсутствует.';
            document.getElementById('modal-genres').innerHTML = (details.genres || []).map(g => `<span class="bg-gray-700 text-gray-200 px-3 py-1 rounded-full text-sm">${escapeHtml(g.name)}</span>`).join('');

            const trailer = (details.videos && details.videos.results) ? details.videos.results.find(v => v.site === 'YouTube' && (v.type === 'Trailer' || v.type === 'Teaser')) : null;
            const trailerLink = document.getElementById('modal-trailer-link');
            if (trailer) {
                trailerLink.href = `${YOUTUBE_WATCH_URL}${trailer.key}`;
                trailerLink.classList.remove('hidden');
            } else trailerLink.classList.add('hidden');

            modal.classList.remove('hidden');
            loadSimilarMovies(movie.id);
            if (db) loadComments(movie.id);
            else loadCommentsOffline(movie.id);
        }

        closeModalBtn.addEventListener('click', () => modal.classList.add('hidden'));

        async function loadSimilarMovies(movieId) {
            similarMoviesGrid.innerHTML = '';
            try {
                const res = await fetch(`${BASE_URL}/movie/${movieId}/recommendations?api_key=${API_KEY}&language=ru-RU&page=1`);
                const data = await res.json();
                if (data && data.results && data.results.length) {
                    data.results.slice(0,10).forEach(m => {
                        const posterUrl = m.poster_path ? `${IMG_URL_POSTER}${m.poster_path}` : PLACEHOLDER_POSTER;
                        const posterEl = document.createElement('div');
                        posterEl.className = 'similar-poster';
                        posterEl.style.backgroundImage = `url('${posterUrl}')`;
                        posterEl.title = m.title;
                        similarMoviesGrid.appendChild(posterEl);
                    });
                    noSimilarMessage.classList.add('hidden');
                } else {
                    noSimilarMessage.classList.remove('hidden');
                }
            } catch (e) {
                console.error('Ошибка загрузки похожих фильмов:', e);
                noSimilarMessage.classList.remove('hidden');
            }
        }

        // Firestore comments loader
        async function loadComments(movieId) {
            commentsList.innerHTML = '';
            const commentsCol = collection(db, `artifacts/${appId}/public/data/comments`);
            const q = query(commentsCol, where('movieId', '==', movieId));
            try {
                const snapshot = await getDocs(q);
                if (snapshot.empty) {
                    noCommentsMessage.classList.remove('hidden');
                } else {
                    noCommentsMessage.classList.add('hidden');
                    snapshot.docs.forEach(d => {
                        const comment = d.data();
                        const userShort = comment.userId ? ('User…' + String(comment.userId).slice(-4)) : 'Аноним';
                        const dateText = comment.createdAt && comment.createdAt.toDate ? comment.createdAt.toDate().toLocaleString() : '';
                        const commentEl = document.createElement('div');
                        commentEl.className = 'comment';
                        commentEl.innerHTML = `
                            <p class="font-semibold text-sm text-red-300">${escapeHtml(userShort)} ${escapeHtml(dateText ? '• ' + dateText : '')}</p>
                            <p class="text-white">${escapeHtml(comment.text || '')}</p>
                        `;
                        commentsList.appendChild(commentEl);
                    });
                }
            } catch (e) {
                console.error('Ошибка загрузки комментариев:', e);
                noCommentsMessage.classList.remove('hidden');
            }
        }

        // Offline comments (localStorage) if no Firebase
        function loadCommentsOffline(movieId) {
            commentsList.innerHTML = '';
            const key = `filmtok_comments_${movieId}`;
            const raw = localStorage.getItem(key);
            if (!raw) {
                noCommentsMessage.classList.remove('hidden');
                return;
            }
            noCommentsMessage.classList.add('hidden');
            try {
                const arr = JSON.parse(raw);
                arr.forEach(c => {
                    const userShort = c.userId ? ('User…' + String(c.userId).slice(-4)) : 'Аноним';
                    const commentEl = document.createElement('div');
                    commentEl.className = 'comment';
                    commentEl.innerHTML = `
                        <p class="font-semibold text-sm text-red-300">${escapeHtml(userShort)}</p>
                        <p class="text-white">${escapeHtml(c.text)}</p>
                    `;
                    commentsList.appendChild(commentEl);
                });
            } catch (e) { console.error(e); noCommentsMessage.classList.remove('hidden'); }
        }

        // submit comment
        commentForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const commentText = commentInput.value.trim();
            if (!commentText || !currentMovieIdForModal) return;

            if (db && userId) {
                try {
                    await addDoc(collection(db, `artifacts/${appId}/public/data/comments`), {
                        movieId: currentMovieIdForModal,
                        text: commentText,
                        userId: userId,
                        createdAt: Timestamp.now(),
                        appId: appId
                    });
                    commentInput.value = '';
                    await loadComments(currentMovieIdForModal);
                } catch (e) {
                    console.error('Ошибка отправки комментария:', e);
                }
            } else {
                // local fallback
                const key = `filmtok_comments_${currentMovieIdForModal}`;
                const raw = localStorage.getItem(key);
                const arr = raw ? JSON.parse(raw) : [];
                arr.push({ movieId: currentMovieIdForModal, text: commentText, userId: userId || 'local', createdAt: new Date().toISOString() });
                localStorage.setItem(key, JSON.stringify(arr));
                commentInput.value = '';
                loadCommentsOffline(currentMovieIdForModal);
            }
        });

        // profile modal
        profileBtn.addEventListener('click', async () => {
            userIdDisplay.value = userId || 'Аноним';
            likedMoviesGrid.innerHTML = '';
            if (db && userId) {
                try {
                    const likesCol = collection(db, `artifacts/${appId}/users/${userId}/likes`);
                    const likesSnap = await getDocs(likesCol);
                    if (likesSnap.empty) likedMoviesGrid.appendChild(noLikesMessage);
                    else {
                        if (noLikesMessage.parentNode) noLikesMessage.parentNode.removeChild(noLikesMessage);
                        likesSnap.docs.forEach(d => {
                            const movie = d.data();
                            const posterUrl = movie.poster_path ? `${IMG_URL_POSTER}${movie.poster_path}` : PLACEHOLDER_POSTER;
                            const posterEl = document.createElement('img');
                            posterEl.src = posterUrl;
                            posterEl.alt = movie.title || '';
                            posterEl.className = 'w-full h-auto rounded-lg shadow-lg';
                            likedMoviesGrid.appendChild(posterEl);
                        });
                    }
                } catch (e) { console.error(e); likedMoviesGrid.appendChild(noLikesMessage); }
            } else {
                // offline: show localStorage liked ids
                if (userLikes.size === 0) likedMoviesGrid.appendChild(noLikesMessage);
                else {
                    if (noLikesMessage.parentNode) noLikesMessage.parentNode.removeChild(noLikesMessage);
                    userLikes.forEach(id => {
                        const movie = moviesData.find(m => String(m.id) === String(id));
                        if (movie) {
                            const posterUrl = movie.poster_path ? `${IMG_URL_POSTER}${movie.poster_path}` : PLACEHOLDER_POSTER;
                            const posterEl = document.createElement('img');
                            posterEl.src = posterUrl;
                            posterEl.alt = movie.title || '';
                            posterEl.className = 'w-full h-auto rounded-lg shadow-lg';
                            likedMoviesGrid.appendChild(posterEl);
                        }
                    });
                }
            }
            profileModal.classList.remove('hidden');
        });

        closeProfileBtn.addEventListener('click', () => profileModal.classList.add('hidden'));

        // initial fetch if firebase failed earlier or after auth
        // (auth flow will call loadUserProfile which calls fetchMovies)
    </script>
</body>
</html>
